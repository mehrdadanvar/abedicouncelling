LIBSQL_URL=file:.data/cms.sqlite
NUXT_CMS_UPLOADS_DIR=.data/uploads
# Editor sign-in (server-only). Set real values in the runtime environment.
ADMIN_EMAIL=
ADMIN_PASS=
# Five-digit secret path of the editor dashboard, e.g. https://…/12345
ADMIN_PATH_CODE=
# Session signing secret, one-time: openssl rand -base64 32
NUXT_APP_SECRET=
